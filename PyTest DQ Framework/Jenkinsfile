pipeline {
    agent any

    environment {
        POSTGRES_SECRET = credentials('POSTGRES_SECRET')
    }

    stages {
        stage('Install Dependencies') {
            steps {
                dir('PyTest DQ Framework') {
                    sh 'pip install --no-cache-dir --break-system-packages -r requirements.txt'
                }
            }
        }

        stage('Run DQ Tests') {
            steps {
                dir('PyTest DQ Framework') {
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                        sh '''
                            mkdir -p html_report
                            pytest tests -m "parquet_data" \
                                --db_host="postgres" \
                                --db_port="5432" \
                                --db_name="mydatabase" \
                                --db_user="$POSTGRES_SECRET_USR" \
                                --db_password="$POSTGRES_SECRET_PSW" \
                                --html=html_report/report.html \
                                --self-contained-html
                        '''
                    }
                }
            }
        }

        stage('Archive Test Report') {
            steps {
                archiveArtifacts artifacts: 'PyTest DQ Framework/html_report/**', allowEmptyArchive: true
            }
        }
    }
}